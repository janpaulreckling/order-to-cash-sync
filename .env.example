# Copy to .env (never commit .env)

# State DB: SQLite for quick local runs, Postgres from docker-compose for the full setup
O2C_DATABASE_URL=sqlite:///./o2c_state.db
# O2C_DATABASE_URL=postgresql+psycopg://o2c:o2c@localhost:5433/o2c_state

# Salesforce Developer Edition (see docs/salesforce_setup.md)
O2C_SF_USERNAME=you@example.com
O2C_SF_PASSWORD=
O2C_SF_SECURITY_TOKEN=
O2C_SF_DOMAIN=login
O2C_SF_API_USAGE_CEILING=0.8

# Odoo (docker-compose defaults)
O2C_ODOO_URL=http://localhost:8069
O2C_ODOO_DB=northwind
O2C_ODOO_USERNAME=admin
O2C_ODOO_PASSWORD=admin
